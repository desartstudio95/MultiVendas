{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Information about a registered user",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "client"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "emailVerified": { "type": "boolean" }
      },
      "required": ["uid", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "A product listed for sale",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "images": { "type": "array" },
        "location": { "type": "string" },
        "delivery": { "type": "string" },
        "sellerContacts": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "sold", "draft", "disabled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "price", "category", "images", "status"]
    },
    "PageContent": {
      "title": "Page Content",
      "description": "Customizable page content for CMS",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "content": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "AppConfig": {
      "title": "App Config",
      "description": "Global application configuration",
      "type": "object",
      "properties": {
        "maintenance": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Product listings"
    },
    "/pages/{pageId}": {
      "schema": "PageContent",
      "description": "Customizable page contents"
    },
    "/config/{configId}": {
      "schema": "AppConfig",
      "description": "App configuration parameters"
    }
  }
}
